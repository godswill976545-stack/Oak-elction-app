# ── Server-side (required) ───────────────────────────────────────────────────
# Used by server.js and the /api/* functions. NEVER prefix with VITE_.

# Cloudflare D1 (replaces Neon)
CLOUDFLARE_ACCOUNT_ID=dc2b378cdfe35e9ab383c3006622f0a3
D1_DATABASE_ID=34083374-0dbc-4070-9489-40c7195f645c
# API token with Account > D1 > Edit (create at dash.cloudflare.com → profile → API Tokens)
CLOUDFLARE_API_TOKEN=

# HMAC secret for admin session tokens (12h). Rotate by regenerating and
# restarting — all sessions invalidate instantly.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=m_q1mt-i3-jbujVOfyFXm0ajixZJHskmP3BKrXH7BuA

# Backblaze B2 (private media bucket, native REST — no S3/SigV4)
# Application key: https://secure.backblazeb2.com/app_keys → "Add a New
# Application Key", scoped to your media bucket. Copy the keyID + applicationKey.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=pro-election-media

# ── Migration only (remove after cutover) ────────────────────────────────────
# Neon source, read by scripts/migrate-neon-to-d1.mjs
# DATABASE_URL=postgresql://...

# ── Removed ──────────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_ADMIN_PIN — no longer used.
